{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExtractorChatCompletionPayload",
  "description": "Payload structure sent to instructor/OpenAI client in extractor_node",
  "type": "object",
  "required": ["model", "messages", "temperature"],
  "properties": {
    "model": {
      "type": "string",
      "enum": ["qwen2.5:14b"]
    },
    "temperature": {
      "type": "number",
      "const": 0.1
    },
    "messages": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant"]
          },
          "content": {
            "type": "string"
          }
        }
      }
    }
  }
}
